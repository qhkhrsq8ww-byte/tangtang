<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tangtang.daemon</string>
  <!-- 部署时替换 __TANGTANG_HOME__ 为仓库绝对路径，例如 /Users/lv/.qclaw/workspace/tangtang -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__TANGTANG_HOME__/code/cat/start-cat.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__TANGTANG_HOME__/code/cat</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__TANGTANG_HOME__/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__TANGTANG_HOME__/logs/launchd.err.log</string>
</dict>
</plist>
