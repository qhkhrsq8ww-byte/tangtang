<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tangtang.daemon</string>
  <!-- 部署时把 __TANGTANG_HOME__ 换成本机 TANGTANG_HOME 绝对路径。只装用户 LaunchAgent。 -->
  <!-- start-cat.sh 是一次性启动器：只启动舞台/宠物页面后退出，不是常驻守护进程。 -->
  <!-- 用户闹铃每分钟检查请用 crontab.example 中的 due ring 模式，或另建 StartInterval 60；不要接到本启动任务。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__TANGTANG_HOME__/code/cat/start-cat.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__TANGTANG_HOME__/code/cat</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>StandardOutPath</key><string>__TANGTANG_HOME__/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__TANGTANG_HOME__/logs/launchd.err.log</string>
</dict>
</plist>
