    "elder": {
      "ids": ["grandpa", "grandma"],
      "silent_streak_24h": 3,
      "oppose_7d_skip_tomorrow": 3,
      "persistent_events": ["water", "meal", "pet_water", "pet_food"]
    },
    "adult": {
