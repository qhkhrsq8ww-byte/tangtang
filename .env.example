# ===== 糖糖 · 环境变量模板 =====
# 复制为 .env 或填入本机 tangtang-config.sh（已被 .gitignore 排除，不入库）
# 真实 Key 只允许存在于本机，严禁提交 Git。

# 百度智能云（STT 语音识别 / TTS 语音合成）
# 申请地址：https://console.bce.baidu.com/ai/#/ai/speech/overview
BAIDU_STT_API_KEY=""
BAIDU_STT_SECRET_KEY=""

# OpenClaw LLM 网关（cat-chat.py 云端对话）
QCLAW_LLM_API_KEY="__QCLAW_AUTH_GATEWAY_MANAGED__"
QCLAW_LLM_BASE_URL="http://127.0.0.1:19000/proxy/llm"
